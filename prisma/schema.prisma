generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id            String       @id @default(uuid())
  userId        String?      @default("default-user")
  title         String
  category      String?      // HEALTH | WORK | LEARNING | PERSONAL
  recurrence    String       @default("DAILY") // DAILY | WEEKLY | MONTHLY | YEARLY
  scheduledTime String?      // e.g. "07:00 AM"
  startDate     DateTime     @default(now())
  endDate       DateTime?
  archived      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  occurrences   Occurrence[]

  @@map("tasks")
}

model Occurrence {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date        String    // ISO Date format: YYYY-MM-DD
  status      String    @default("PENDING") // PENDING | DONE | MISSED | SKIPPED
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([taskId, date])
  @@index([taskId, date])
  @@map("occurrences")
}
