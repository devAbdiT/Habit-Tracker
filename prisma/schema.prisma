generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  HEALTH
  WORK
  LEARNING
  PERSONAL
}

enum LogStatus {
  DONE
  MISSED
  PENDING
  SKIPPED
}

model Habit {
  id            String     @id @default(uuid())
  title         String
  description   String?
  category      Category   @default(PERSONAL)
  scheduledTime String?    // e.g. "07:00 AM"
  icon          String?    // Lucide icon name string e.g. "Sun", "Brain", "BookOpen"
  color         String?    // Optional override or custom tag
  archived      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  logs          HabitLog[]

  @@map("habits")
}

model HabitLog {
  id        String    @id @default(uuid())
  habitId   String
  habit     Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String    // ISO date format YYYY-MM-DD
  status    LogStatus @default(PENDING)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([habitId, date])
  @@map("habit_logs")
}
