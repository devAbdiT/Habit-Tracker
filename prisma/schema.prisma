generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  HEALTH
  WORK
  LEARNING
  PERSONAL
}

enum Recurrence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum Status {
  PENDING
  DONE
  MISSED
  SKIPPED
}

model Task {
  id            String       @id @default(uuid())
  userId        String?      @default("default-user")
  title         String
  category      Category?
  recurrence    Recurrence   @default(DAILY)
  scheduledTime String?      // e.g. "07:00 AM"
  startDate     DateTime     @default(now())
  endDate       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  occurrences   Occurrence[]

  @@map("tasks")
}

model Occurrence {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date        String    // ISO Date format: YYYY-MM-DD
  status      Status    @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([taskId, date])
  @@index([taskId, date])
  @@map("occurrences")
}
